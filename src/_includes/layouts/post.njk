---
layout: layouts/base.njk
bodyClass: page-post
stylesheet: /css/pages/post.css
---
<main class="stage">
  <header class="stage__head">
    <div class="mosaic" aria-hidden="true">
      {%- for i in range(0, 16) %}<i></i>{% endfor -%}
    </div>
    <h1 class="stage__title">{{ title }}</h1>
    {#- static orbit + dots, with an emblem whose ring of text is the only
        thing that moves (the ring is its own <svg> so CSS can spin it) -#}
    <div class="orbit" aria-hidden="true">
      <svg class="orbit__path" viewBox="0 0 460 220">
        <g transform="rotate(-9 230 110)">
          <ellipse class="orbit__line" cx="230" cy="110" rx="200" ry="62"/>
          <circle class="orbit__dot" cx="42" cy="89" r="8"/>
          <circle class="orbit__dot" cx="57" cy="79" r="3.5"/>
          <circle class="orbit__dot" cx="265" cy="171" r="17"/>
          <circle class="orbit__dot" cx="415" cy="87" r="9"/>
        </g>
      </svg>
      <span class="orbit__emblem">
        <svg class="orbit__disc" viewBox="-60 -60 120 120">
          <circle r="58" class="orbit__teal"/>
          <circle r="56" class="orbit__edge"/>
          <circle r="34" class="orbit__white"/>
          <circle r="31" class="orbit__teal"/>
          <circle r="28" class="orbit__pale"/>
          <circle cx="0" cy="-12.5" r="10" class="orbit__leaf"/>
          <circle cx="10.8" cy="6.25" r="10" class="orbit__leaf"/>
          <circle cx="-10.8" cy="6.25" r="10" class="orbit__leaf"/>
        </svg>
        <svg class="orbit__ring" viewBox="-60 -60 120 120">
          <defs><path id="orbit-ring-path" d="M 0 -45 A 45 45 0 1 1 -0.01 -45" fill="none"/></defs>
          <text><textPath href="#orbit-ring-path" textLength="282" lengthAdjust="spacing">{{ site.name | upper }} ✦ </textPath></text>
        </svg>
      </span>
    </div>
  </header>

  <p class="stage__bar">
    <time datetime="{{ page.date | dateISO }}">{{ page.date | dateDisplay }}</time>
  </p>

  <article class="stage__body">
    {{ content | safe }}
  </article>

  <p class="stage__bar stage__bar--foot">
    {%- set shown = false -%}
    {%- for t in tags %}{% if t != "post" %}{% if shown %} · {% endif %}{{ t }}{% set shown = true %}{% endif %}{% endfor -%}
    {%- if not shown %}journal{% endif -%}
  </p>

  <footer class="stage__foot">
    <a class="pill pill--exit" href="/blog/">Exit</a>
  </footer>

  <div class="mosaic mosaic--foot" aria-hidden="true">
    {%- for i in range(0, 8) %}<i></i>{% endfor -%}
  </div>
</main>
