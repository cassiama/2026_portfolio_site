<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% if title %}{{ title }} · {% endif %}{{ site.name }}</title>
    <meta name="description" content="{{ desc or site.description }}">
    <meta name="color-scheme" content="light">
    <link rel="icon" href="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2032%2032'%3E%3Ccircle%20cx='16'%20cy='16'%20r='15'%20fill='%23cfe24e'/%3E%3Ccircle%20cx='16'%20cy='16'%20r='9'%20fill='none'%20stroke='%23f49d3f'%20stroke-width='3'/%3E%3Ccircle%20cx='16'%20cy='16'%20r='3.5'%20fill='%23fdfdf4'/%3E%3C/svg%3E">
    <link rel="preload" href="/fonts/archivo-black-400.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/jost-variable.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="/css/tokens.css">
    <link rel="stylesheet" href="/css/base.css">
    {%- if disc %}
    <link rel="stylesheet" href="/css/disc.css">
    {%- endif %}
    {%- if stylesheet %}
    <link rel="stylesheet" href="{{ stylesheet }}">
    {%- endif %}
  </head>
  <body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
    <div class="screen">
      <div class="screen__frame">
        {%- if disc %}{% include "components/disc.njk" %}{% endif %}
        <div class="screen__content">
          {{ content | safe }}
        </div>
      </div>
      {%- if disc == "face" %}
      {% include "components/corner-disc.njk" %}
      {%- endif %}
      {%- if tab %}
      <p class="tab"><span class="tab__inner">{{ tab }}</span></p>
      {%- endif %}
      <p class="screen__corner">&copy; {{ site.year }} {{ site.name }}</p>
    </div>
  </body>
</html>
