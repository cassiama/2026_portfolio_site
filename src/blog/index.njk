---
layout: layouts/base.njk
title: Blog
tab: Blog
desc: Notes on CSS, the web platform, and Y2K interface archaeology.
bodyClass: page-blog
disc: floor
stylesheet: /css/pages/blog.css
---
<h1 class="sr-only">Blog</h1>

<main class="challenge">
  {%- if collections.post | length %}
  <ol class="coins">
    {%- for post in collections.post %}
    <li class="coins__item">
      <a class="coin" href="{{ post.url }}" aria-label="{{ post.data.title }}">{{ loop.index | pad2 }}</a>
      <span class="coin-caption" aria-hidden="true">{{ post.data.title }} — {{ post.date | dateDisplay }}</span>
    </li>
    {%- endfor %}
  </ol>
  {%- else %}
  <div class="construction">
    <p class="construction__title">Under construction</p>
    <p class="construction__note">Nothing worth posting yet. Check back later.</p>
  </div>
  {%- endif %}

  <footer class="challenge__foot">
    <a class="pill pill--exit" href="/">Exit</a>
  </footer>

  <p class="challenge__bar"><span class="challenge__default">{% if collections.post | length %}Select an entry{% else %}Coming soon{% endif %}</span></p>
</main>
